STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-v2

# Production media storage. Use any S3-compatible provider (AWS S3,
# Cloudflare R2, Supabase Storage S3, MinIO...). Without these values the
# backend falls back to local disk, which is only safe for development.
S3_FILE_URL=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PREFIX=uploads/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_ACL=public-read

# Email notifications. SMTP has priority when configured. If SMTP and Resend
# are empty, Medusa uses the local notification provider and logs emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
INVITE_USER_EMAIL_TEMPLATE=user-invited

# Webflow CMS product sync. WEBFLOW_SITE_ID is only needed once, to run
# create-webflow-products-collection. Leave WEBFLOW_API_TOKEN or
# WEBFLOW_PRODUCTS_COLLECTION_ID empty to disable the sync (it becomes a no-op).
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_PRODUCTS_COLLECTION_ID=
WEBFLOW_SYNC_CURRENCY_CODE=eur
